// =============================================================================
// AUTOFORGE PRISMA SCHEMA - VERSION 2.0
// =============================================================================
// 
// File: prisma/schema.prisma
// 
// Complete schema including:
// - Authentication (NextAuth for platform)
// - Generation tracking
// - Monetization (Stripe Connect, subscriptions, payouts)
// - NEW: Managed Infrastructure (Supabase, Clerk, Vercel auto-provisioning)
//
// To apply: npx prisma migrate dev --name add_managed_infrastructure
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

// =============================================================================
// AUTHENTICATION MODELS (NextAuth - for AutoForge platform itself)
// =============================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =============================================================================
// USER MODEL
// =============================================================================

enum UserRole {
  CREATOR   // Can build and sell apps
  CUSTOMER  // Can only buy and use apps
  PARTNER   // Can refer and earn
  ADMIN     // Platform admin
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  emailVerified    DateTime?
  image            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  // NEW: User role for guest checkout
  role             UserRole  @default(CREATOR)

  // Stripe Customer ID (for platform subscription)
  stripeCustomerId String?   @unique

  // Relations
  accounts         Account[]
  sessions         Session[]
  generationJobs   GenerationJob[]

  // Monetization relations
  subscription     CreatorSubscription?
  connectedAccount StripeConnectedAccount?
  publishedApps    PublishedApp[]
  payouts          Payout[]

  // NEW: Managed Infrastructure
  managedProjects  ManagedProject[]
  managedApps      ManagedApp[]

  // Support tickets
  supportTickets   SupportTicket[]

  // Integration credentials
  integrationCredentials IntegrationCredential[]

  // NEW: Guest checkout - magic links and app subscriptions
  magicLinks       MagicLink[]
  appSubscriptions AppSubscription[]
  partner          Partner?

  @@index([email])
  @@index([stripeCustomerId])
  @@index([role])
}

// =============================================================================
// CREATOR SUBSCRIPTION (Platform billing - $49/$99/$249 per month)
// =============================================================================

model CreatorSubscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  
  // Stripe subscription details
  stripeSubscriptionId   String             @unique
  stripePriceId          String
  stripeCurrentPeriodEnd DateTime
  
  // Subscription status
  status                 SubscriptionStatus @default(ACTIVE)
  plan                   PlanTier           @default(STARTER)
  
  // Trial information
  trialEndsAt            DateTime?
  
  // Cancellation
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  
  // Timestamps
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  
  // Relations
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([stripeSubscriptionId])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  UNPAID
  PAUSED
}

enum PlanTier {
  FREE       // Limited features, 1 app, 14-day preview expiration
  STARTER    // $49/mo - 5 published apps, 8% fee
  PRO        // $99/mo - 20 published apps, 6% fee
  BUSINESS   // $249/mo - Unlimited apps, 4% fee
  ENTERPRISE // Custom pricing
}

// =============================================================================
// STRIPE CONNECTED ACCOUNT (For creator payouts)
// =============================================================================

model StripeConnectedAccount {
  id                    String   @id @default(cuid())
  userId                String   @unique
  
  // Stripe Connect account details
  stripeAccountId       String   @unique
  
  // Onboarding status
  onboardingComplete    Boolean  @default(false)
  chargesEnabled        Boolean  @default(false)
  payoutsEnabled        Boolean  @default(false)
  detailsSubmitted      Boolean  @default(false)
  
  // Account type
  accountType           String   @default("express") // express, standard, custom
  
  // Business information (from Stripe)
  businessName          String?
  businessUrl           String?
  country               String   @default("US")
  defaultCurrency       String   @default("usd")
  
  // Timestamps
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // Relations
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeAccountId])
  @@index([onboardingComplete])
}

// =============================================================================
// PUBLISHED APP (Monetized applications)
// =============================================================================

model PublishedApp {
  id                String       @id @default(cuid())

  // Owner
  userId            String
  generationJobId   String

  // App details
  name              String
  slug              String       @unique  // For subdomain: {slug}.autoforge.app
  description       String?
  logoUrl           String?

  // Marketplace category
  categoryId        String?      // NEW: Category classification
  tags              String[]     // NEW: Searchable tags

  // Custom domain (optional)
  customDomain      String?      @unique
  domainVerified    Boolean      @default(false)

  // Deployment
  deploymentUrl     String?
  vercelProjectId   String?

  // Pricing configuration
  pricingModel      PricingModel @default(SUBSCRIPTION)

  // Subscription pricing (in cents)
  monthlyPrice      Int?         // e.g., 900 = $9.00
  yearlyPrice       Int?

  // One-time pricing (in cents)
  oneTimePrice      Int?

  // Free trial
  trialDays         Int          @default(0)

  // Stripe product/price IDs
  stripeProductId    String?
  stripePriceMonthly String?
  stripePriceYearly  String?
  stripePriceOneTime String?

  // App status
  status            AppStatus    @default(DRAFT)
  publishedAt       DateTime?

  // Analytics
  totalRevenue      Int          @default(0) // In cents
  totalCustomers    Int          @default(0)
  monthlyRecurring  Int          @default(0) // MRR in cents

  // Timestamps
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationJob     GenerationJob     @relation(fields: [generationJobId], references: [id], onDelete: Cascade)
  category          AppCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  customers         AppCustomer[]
  transactions      Transaction[]
  appSubscriptions  AppSubscription[] // NEW: Guest checkout subscriptions

  @@index([userId])
  @@index([slug])
  @@index([status])
  @@index([customDomain])
  @@index([categoryId])
}

enum PricingModel {
  FREE
  SUBSCRIPTION
  ONE_TIME
  FREEMIUM  // Free tier + paid features
}

enum AppStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  SUSPENDED
  ARCHIVED
}

// =============================================================================
// APP CUSTOMER (End-users who pay for published apps)
// =============================================================================

enum AppCustomerStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  SUSPENDED
}

model AppCustomer {
  id                     String       @id @default(cuid())

  // Which app
  publishedAppId         String

  // Customer details
  email                  String
  name                   String?

  // NEW: Link to User account (for guest checkout)
  userId                 String?

  // Stripe customer (on the connected account)
  stripeCustomerId       String

  // Subscription details (if subscription model)
  stripeSubscriptionId   String?
  subscriptionStatus     String?      // active, canceled, past_due, etc.
  currentPeriodEnd       DateTime?

  // One-time purchase (if one-time model)
  purchasedAt            DateTime?

  // Access control
  hasAccess              Boolean      @default(true)
  accessExpiresAt        DateTime?

  // NEW: Status tracking
  status                 AppCustomerStatus @default(ACTIVE)

  // Timestamps
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  // Relations
  publishedApp           PublishedApp @relation(fields: [publishedAppId], references: [id], onDelete: Cascade)

  @@unique([publishedAppId, email])
  @@index([publishedAppId])
  @@index([stripeCustomerId])
  @@index([email])
  @@index([userId])
  @@index([status])
}

// =============================================================================
// APP SUBSCRIPTION (Guest checkout - Customer account linked to app)
// =============================================================================

model AppSubscription {
  id                   String       @id @default(cuid())

  // Customer (now has an account)
  userId               String

  // Which app
  publishedAppId       String

  // Subscription details
  stripeSubscriptionId String?      @unique
  status               String       @default("ACTIVE")  // ACTIVE, CANCELLED, EXPIRED

  // Lifecycle
  startedAt            DateTime     @default(now())
  cancelledAt          DateTime?
  expiresAt            DateTime?

  // Timestamps
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  // Relations
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishedApp         PublishedApp @relation(fields: [publishedAppId], references: [id], onDelete: Cascade)

  @@unique([userId, publishedAppId])
  @@index([userId])
  @@index([publishedAppId])
  @@index([status])
  @@index([stripeSubscriptionId])
}

// =============================================================================
// MAGIC LINK AUTHENTICATION (Passwordless auth for guest customers)
// =============================================================================

model MagicLink {
  id        String    @id @default(cuid())
  userId    String

  // Token
  token     String    @unique

  // Lifecycle
  expiresAt DateTime
  usedAt    DateTime?

  // Timestamps
  createdAt DateTime  @default(now())

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

// =============================================================================
// PARTNER PROGRAM (Referrals and revenue sharing)
// =============================================================================

enum PartnerTier {
  AFFILIATE  // 20% commission
  AGENCY     // 30% commission
  RESELLER   // 40% commission
}

enum PartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  TERMINATED
}

model Partner {
  id              String        @id @default(cuid())
  userId          String        @unique

  // Partner tier and status
  tier            PartnerTier
  status          PartnerStatus @default(ACTIVE)

  // Referral code
  referralCode    String        @unique

  // Commission rate (percentage)
  commissionRate  Int           // 20, 30, or 40

  // Analytics
  totalReferrals  Int           @default(0)
  totalEarnings   Int           @default(0)  // In cents

  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals       Referral[]

  @@index([referralCode])
  @@index([tier])
  @@index([status])
}

model Referral {
  id              String    @id @default(cuid())
  partnerId       String

  // Referred user
  referredUserId  String
  referredEmail   String

  // Conversion tracking
  converted       Boolean   @default(false)
  convertedAt     DateTime?

  // Revenue from this referral (in cents)
  totalRevenue    Int       @default(0)
  commissionEarned Int      @default(0)

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  partner         Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([referredUserId])
  @@index([converted])
}

// =============================================================================
// TRANSACTION (Revenue events)
// =============================================================================

model Transaction {
  id                    String            @id @default(cuid())
  
  // Which app
  publishedAppId        String
  
  // Stripe payment details
  stripePaymentIntentId String?           @unique
  stripeChargeId        String?
  stripeInvoiceId       String?
  
  // Amounts (all in cents)
  grossAmount           Int               // Total charged to customer
  stripeFee             Int               // Stripe's processing fee
  platformFee           Int               // AutoForge's fee (4-8%)
  netAmount             Int               // Creator receives this
  
  // Fee percentage at time of transaction
  platformFeePercent    Float             @default(8.0)
  
  // Currency
  currency              String            @default("usd")
  
  // Transaction type
  type                  TransactionType
  
  // Status
  status                TransactionStatus @default(PENDING)
  
  // Customer info
  customerEmail         String?
  
  // Timestamps
  createdAt             DateTime          @default(now())
  paidOutAt             DateTime?
  
  // Relations
  publishedApp          PublishedApp      @relation(fields: [publishedAppId], references: [id], onDelete: Cascade)
  payout                Payout?           @relation(fields: [payoutId], references: [id])
  payoutId              String?

  @@index([publishedAppId])
  @@index([status])
  @@index([createdAt])
  @@index([payoutId])
}

enum TransactionType {
  SUBSCRIPTION_PAYMENT
  ONE_TIME_PAYMENT
  REFUND
  CHARGEBACK
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  DISPUTED
}

// =============================================================================
// PAYOUT (Weekly payouts to creators)
// =============================================================================

model Payout {
  id                  String       @id @default(cuid())
  
  // Creator
  userId              String
  
  // Stripe payout details
  stripePayoutId      String?      @unique
  stripeTransferId    String?
  
  // Amount
  amount              Int          // In cents
  currency            String       @default("usd")
  
  // Period this payout covers
  periodStart         DateTime
  periodEnd           DateTime
  
  // Status
  status              PayoutStatus @default(PENDING)
  
  // Failure info
  failureCode         String?
  failureMessage      String?
  
  // Timestamps
  createdAt           DateTime     @default(now())
  arrivedAt           DateTime?
  
  // Relations
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions        Transaction[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum PayoutStatus {
  PENDING
  IN_TRANSIT
  PAID
  FAILED
  CANCELED
}

// =============================================================================
// MANAGED INFRASTRUCTURE (NEW - AutoForge 2.0)
// =============================================================================
// These models support the "Go Live" feature that auto-provisions:
// - Supabase (PostgreSQL database)
// - Clerk (Authentication)
// - Stripe (Payments in test mode)
// - Vercel (Hosting)
// =============================================================================

model ManagedProject {
  id                    String               @id @default(cuid())
  userId                String
  generationJobId       String               @unique
  
  // Supabase
  supabaseProjectId     String?
  supabaseUrl           String?
  supabaseAnonKey       String?
  supabaseServiceKey    String?              // Encrypted
  supabaseDbPassword    String?              // Encrypted
  
  // Clerk (if using per-project instances)
  clerkInstanceId       String?
  clerkPublishableKey   String?
  clerkSecretKey        String?              // Encrypted
  
  // Vercel
  vercelProjectId       String?
  vercelDeploymentId    String?
  vercelUrl             String?
  vercelTeamId          String?
  
  // Stripe (Test Mode for Preview)
  stripeTestPublishable String?
  stripeTestSecret      String?              // Encrypted
  stripeTestWebhookId   String?
  stripeTestWebhookSecret String?            // Encrypted
  
  // Production Stripe (after Go Live)
  stripeLivePublishable String?
  stripeLiveSecret      String?              // Encrypted
  stripeLiveWebhookId   String?
  stripeLiveWebhookSecret String?            // Encrypted
  
  // Environment Variables (JSON blob of all env vars)
  environmentVariables  Json?
  
  // Status
  status                ManagedProjectStatus @default(PROVISIONING)
  provisioningStep      String?              // Current step being executed
  errorMessage          String?
  
  // Lifecycle
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  expiresAt             DateTime?            // For free tier cleanup (7 days)
  
  // Whether this is a paid/permanent project
  isPermanent           Boolean              @default(false)
  
  // Relations
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationJob         GenerationJob        @relation(fields: [generationJobId], references: [id], onDelete: Cascade)
  provisioningLogs      ProvisioningLog[]

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([vercelUrl])
}

enum ManagedProjectStatus {
  PROVISIONING       // Initial state - setting up infrastructure
  DATABASE_READY     // Supabase provisioned
  AUTH_READY         // Clerk configured
  PAYMENTS_READY     // Stripe test mode configured
  PREVIEW_READY      // Deployed to Vercel, ready to use
  DEPLOYED           // Production deployment complete
  UPGRADING          // Being upgraded (e.g., adding production Stripe)
  ERROR              // Something went wrong
  EXPIRED            // Free tier expired and cleaned up
  DELETED            // Manually deleted by user
}

// Track each provisioning step for debugging and progress reporting
model ProvisioningLog {
  id                String         @id @default(cuid())
  managedProjectId  String
  
  // Step information
  step              String         // 'supabase_create', 'supabase_migrate', 'clerk_setup', etc.
  status            String         // 'started', 'completed', 'failed', 'skipped'
  
  // Timing
  startedAt         DateTime       @default(now())
  completedAt       DateTime?
  duration          Int?           // Duration in milliseconds
  
  // Error information
  errorMessage      String?
  errorStack        String?
  
  // Additional metadata
  metadata          Json?          // Any extra info about this step
  
  // Relations
  managedProject    ManagedProject @relation(fields: [managedProjectId], references: [id], onDelete: Cascade)

  @@index([managedProjectId])
  @@index([step])
  @@index([status])
  @@index([startedAt])
}

// =============================================================================
// GENERATION MODELS
// =============================================================================

model GenerationJob {
  id                    String                @id @default(cuid())
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  status                JobStatus             @default(PENDING)
  prompt                String
  enhancedPrompt        String?
  enhancementUsed       Boolean               @default(false)
  planJson              String?
  result                String?
  filesJson             String?
  userId                String
  blueprint             String?
  blueprintApprovedAt   DateTime?
  blueprintGeneratedAt  DateTime?
  completedModules      Int                   @default(0)
  errorLog              String?
  failedModules         Int                   @default(0)
  generationCompletedAt DateTime?
  generationStartedAt   DateTime?
  totalModules          Int                   @default(0)

  // Screenshot/thumbnail for visual preview
  thumbnailUrl          String?

  // NEW: Generation mode (Personal Tool vs SaaS)
  generationMode        GenerationMode        @default(PERSONAL)
  parentJobId           String?               // For SaaS upgrades, points to original personal tool

  // Relations
  files                 GeneratedFile[]
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  telemetry             GenerationTelemetry[]
  previewSessions       PreviewSession[]
  deployments           Deployment[]

  // Monetization relation
  publishedApps         PublishedApp[]

  // NEW: Managed Infrastructure relation
  managedProject        ManagedProject?
  managedApp            ManagedApp?

  // NEW: SaaS upgrade tracking
  parentJob             GenerationJob?        @relation("SaaSUpgrade", fields: [parentJobId], references: [id])
  upgradedJobs          GenerationJob[]       @relation("SaaSUpgrade")

  // Viral sharing
  shareLink             ShareLink?
  remixedFrom           ShareRemix?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([generationMode])
  @@index([parentJobId])
}

model GeneratedFile {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now())
  generationJobId String
  path            String
  content         String
  language        String
  size            Int           @default(0)
  generationJob   GenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Cascade)

  @@unique([generationJobId, path])
  @@index([generationJobId])
}

model GenerationTelemetry {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now())
  generationJobId String
  eventType       String
  errorMessage    String?
  stackTrace      String?
  metadata        Json?
  generationJob   GenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Cascade)

  @@index([generationJobId])
  @@index([eventType])
  @@index([createdAt])
}

// =============================================================================
// PREVIEW AND DEPLOYMENT
// =============================================================================

model PreviewSession {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now())
  expiresAt       DateTime
  generationJobId String
  files           Json
  accessCount     Int           @default(0)
  lastAccessedAt  DateTime?
  generationJob   GenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Cascade)

  @@index([generationJobId])
  @@index([expiresAt])
}

model Deployment {
  id                 String           @id @default(cuid())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  generationJobId    String
  vercelDeploymentId String?          @unique
  vercelProjectId    String?
  deploymentUrl      String?
  status             DeploymentStatus @default(PENDING)
  errorMessage       String?
  buildLogs          String?
  generationJob      GenerationJob    @relation(fields: [generationJobId], references: [id], onDelete: Cascade)

  @@index([generationJobId])
  @@index([status])
  @@index([createdAt])
}

enum DeploymentStatus {
  PENDING
  BUILDING
  READY
  ERROR
  CANCELLED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  BLUEPRINT_GENERATED
  BLUEPRINT_APPROVED
  COMPOSING
  TESTING
  DEPLOYING
  CANCELLED
}

enum GenerationMode {
  PREVIEW       // Free preview with mock data (no integrations, no quality checks, WebContainer-compatible)
  PERSONAL      // Simple, single-user tool (localStorage, no auth, basic code)
  SINGLE_USER   // Production-grade app for one user (real backend/DB, no auth, industry-level code)
  SAAS          // Full SaaS with auth, payments, multi-tenant DB
  SAAS_UPGRADE  // Personal/Single-user tool upgraded to SaaS
}

// =============================================================================
// INFRASTRUCTURE CLEANUP TRACKING
// =============================================================================
// Track when free tier projects should be cleaned up

model CleanupTask {
  id                String        @id @default(cuid())
  managedProjectId  String
  
  // What to clean up
  cleanupType       CleanupType
  resourceId        String        // Supabase project ID, Vercel project ID, etc.
  
  // Scheduling
  scheduledFor      DateTime
  
  // Status
  status            CleanupStatus @default(PENDING)
  
  // Execution
  executedAt        DateTime?
  errorMessage      String?
  retryCount        Int           @default(0)
  
  // Timestamps
  createdAt         DateTime      @default(now())

  @@index([scheduledFor])
  @@index([status])
  @@index([managedProjectId])
}

enum CleanupType {
  SUPABASE_PROJECT
  CLERK_INSTANCE
  VERCEL_PROJECT
  STRIPE_WEBHOOK
  FULL_PROJECT      // Clean up everything
}

enum CleanupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

// =============================================================================
// USAGE TRACKING (For billing and limits)
// =============================================================================

model UsageRecord {
  id          String      @id @default(cuid())
  userId      String
  
  // What was used
  usageType   UsageType
  quantity    Int         @default(1)
  
  // Context
  resourceId  String?     // generationJobId, managedProjectId, etc.
  
  // Billing period
  periodStart DateTime
  periodEnd   DateTime
  
  // Timestamps
  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([usageType])
  @@index([periodStart, periodEnd])
  @@index([createdAt])
}

enum UsageType {
  GENERATION          // App generation
  MANAGED_PROJECT     // Provisioned infrastructure
  DEPLOYMENT          // Vercel deployment
  AI_TOKENS           // Claude API tokens used
  BANDWIDTH           // Data transfer
}

// =============================================================================
// END-TO-END MANAGED PLATFORM (NEW)
// =============================================================================
// AutoForge hosts EVERYTHING - database, AI proxy, auth, deployment
// User never sees API keys - just works!
// =============================================================================

model ManagedApp {
  id                    String               @id @default(cuid())
  userId                String
  generationJobId       String               @unique

  // App identification
  name                  String
  subdomain             String               @unique  // my-app.autoforge.app
  customDomain          String?              @unique
  description           String?              // App description for marketplace
  logoUrl               String?              // Logo for marketplace

  // Marketplace
  categoryId            String?              // Category (bots, trading, scrapers, etc.)
  isPublicInMarketplace Boolean              @default(false)
  marketplaceViews      Int                  @default(0)
  marketplaceInstalls   Int                  @default(0)
  tags                  String[]             // Searchable tags

  // Credentials (for app to call AutoForge APIs)
  apiKey                String               @unique  // Secret key app uses to auth
  appSecret             String               // For signing requests

  // Database (multi-tenant schema on shared DB)
  schemaName            String               @unique  // app_abc123_schema
  databaseConnectionString String           // Connection string for this schema

  // Deployment
  vercelProjectId       String?
  vercelDeploymentId    String?
  deploymentUrl         String?

  // Status
  status                ManagedAppStatus     @default(PROVISIONING)

  // Lifecycle
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  publishedAt           DateTime?

  // Relations
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationJob         GenerationJob        @relation(fields: [generationJobId], references: [id], onDelete: Cascade)
  category              AppCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  usageRecords          AppUsageRecord[]
  healthChecks          HealthCheck[]
  monitoringAlerts      MonitoringAlert[]
  supportTickets        SupportTicket[]

  @@index([userId])
  @@index([subdomain])
  @@index([status])
  @@index([apiKey])
  @@index([categoryId])
  @@index([isPublicInMarketplace])
}

enum ManagedAppStatus {
  PROVISIONING       // Setting up infrastructure
  ACTIVE             // Live and working
  SUSPENDED          // Exceeded limits, suspended
  DELETED            // User deleted
}

// Track AI operations, database usage, bandwidth per app
model AppUsageRecord {
  id              String      @id @default(cuid())
  managedAppId    String

  // What happened
  eventType       AppUsageEvent

  // AI usage
  aiOps           Int         @default(0)   // Number of AI operations
  tokensUsed      Int         @default(0)   // Tokens consumed

  // Database usage
  dbQueries       Int         @default(0)   // Number of queries
  dbStorage       Int         @default(0)   // Bytes stored

  // Bandwidth
  bandwidthBytes  Int         @default(0)

  // Timestamp
  createdAt       DateTime    @default(now())

  // Relations
  managedApp      ManagedApp  @relation(fields: [managedAppId], references: [id], onDelete: Cascade)

  @@index([managedAppId])
  @@index([eventType])
  @@index([createdAt])
}

enum AppUsageEvent {
  AI_CHAT_COMPLETION
  AI_STREAMING
  DATABASE_QUERY
  DATABASE_WRITE
  BANDWIDTH_OUT
  FILE_UPLOAD
}

// Monthly aggregate usage per user (for billing)
model MonthlyUsage {
  id              String    @id @default(cuid())
  userId          String

  // Billing period
  month           Int       // 0-11
  year            Int       // 2025

  // Totals
  totalAiOps      Int       @default(0)
  totalTokens     Int       @default(0)
  totalDbStorage  Int       @default(0)  // Bytes
  totalBandwidth  Int       @default(0)  // Bytes
  totalApps       Int       @default(0)

  // Costs (in cents)
  aiCost          Int       @default(0)
  storageCost     Int       @default(0)
  bandwidthCost   Int       @default(0)
  totalCost       Int       @default(0)

  // Overage charges
  overageCost     Int       @default(0)

  // Last updated
  updatedAt       DateTime  @updatedAt

  @@unique([userId, month, year])
  @@index([userId])
  @@index([year, month])
}

// Subscription limits by plan tier
model PlanLimits {
  id            String    @id @default(cuid())
  plan          PlanTier  @unique

  // Limits
  maxApps       Int       // Max number of apps
  maxAiOps      Int       // AI operations per month
  maxDbStorage  Int       // Database storage in MB
  maxBandwidth  Int       // Bandwidth in GB

  // Overage pricing (in cents)
  overageAiOps       Float  // Cost per 1000 extra AI ops
  overageStorage     Float  // Cost per GB extra storage
  overageBandwidth   Float  // Cost per GB extra bandwidth

  // Features
  customDomain       Boolean
  prioritySupport    Boolean

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// =============================================================================
// MARKETPLACE CATEGORIES
// =============================================================================

model AppCategory {
  id          String    @id @default(cuid())

  // Category details
  name        String    @unique  // "Bots", "Trading Systems", etc.
  slug        String    @unique  // "bots", "trading-systems"
  description String?
  icon        String?   // Icon/emoji for UI
  color       String?   // Color hex code for UI

  // Display order
  sortOrder   Int       @default(0)

  // Visibility
  isActive    Boolean   @default(true)
  isFeatured  Boolean   @default(false)

  // Statistics
  appCount    Int       @default(0)  // Cached count of apps

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  publishedApps PublishedApp[]
  managedApps   ManagedApp[]

  @@index([slug])
  @@index([isActive])
  @@index([isFeatured])
  @@index([sortOrder])
}

// =============================================================================
// MONITORING & HEALTH CHECKS
// =============================================================================

model HealthCheck {
  id            String      @id @default(cuid())
  managedAppId  String

  // Health status
  status        HealthStatus
  responseTime  Int         // Response time in milliseconds
  statusCode    Int?        // HTTP status code
  error         String?     // Error message if down

  // Timestamp
  timestamp     DateTime    @default(now())

  // Relations
  managedApp    ManagedApp  @relation(fields: [managedAppId], references: [id], onDelete: Cascade)

  @@index([managedAppId])
  @@index([timestamp])
  @@index([status])
}

enum HealthStatus {
  healthy
  degraded
  down
}

model MonitoringAlert {
  id            String       @id @default(cuid())
  managedAppId  String

  // Alert details
  issue         String
  severity      AlertSeverity
  autoHealed    Boolean      @default(false)

  // Notification
  notifiedAt    DateTime     @default(now())
  acknowledgedAt DateTime?

  // Relations
  managedApp    ManagedApp   @relation(fields: [managedAppId], references: [id], onDelete: Cascade)

  @@index([managedAppId])
  @@index([severity])
  @@index([notifiedAt])
}

enum AlertSeverity {
  critical
  warning
  info
}

// =============================================================================
// SUPPORT TICKETING SYSTEM
// =============================================================================

model SupportTicket {
  id              String           @id @default(cuid())
  userId          String
  managedAppId    String?          // Optional: associated with specific app

  // Ticket details
  subject         String
  description     String
  category        TicketCategory
  priority        TicketPriority   @default(MEDIUM)
  status          TicketStatus     @default(OPEN)

  // AI triage
  aiTriaged       Boolean          @default(false)
  aiSuggestion    String?          // AI-suggested solution
  aiConfidence    Float?           // Confidence score (0-1)

  // Assignment
  assignedTo      String?          // Support agent ID
  assignedAt      DateTime?

  // Resolution
  resolvedAt      DateTime?
  resolution      String?

  // Timestamps
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  managedApp      ManagedApp?      @relation(fields: [managedAppId], references: [id], onDelete: SetNull)
  messages        TicketMessage[]

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

enum TicketCategory {
  TECHNICAL       // App not working, errors
  BILLING         // Payment, subscription issues
  FEATURE_REQUEST // New feature requests
  BUG_REPORT      // Bug reports
  GENERAL         // General questions
  ACCOUNT         // Account issues
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String

  // Message details
  content   String
  isStaff   Boolean       @default(false)  // True if from support staff
  authorId  String?       // User or staff ID

  // Attachments
  attachments Json?       // Array of file URLs

  // Timestamps
  createdAt DateTime      @default(now())

  // Relations
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
}

// ============================================================================
// LAYER 4: FAILURE TRACKING & LEARNING
// ============================================================================

model GenerationFailure {
  id        String   @id @default(cuid())

  // Error details
  errorType     String       // nextjs, typescript, dependency, syntax, unknown
  errorMessage  String       @db.Text
  errorFile     String?
  errorLine     Int?
  errorCode     String?      @db.Text

  // Generation context
  prompt        String       @db.Text
  generator     String       // bolt, saas, workflow, agent, api, etc.
  filesGenerated Int         @default(0)

  // Recovery attempt
  recovered     Boolean      @default(false)
  fixApplied    String?      @db.Text
  attemptsCount Int          @default(1)

  // Metadata
  userId        String?
  jobId         String?

  // Timestamps
  createdAt     DateTime     @default(now())
  resolvedAt    DateTime?

  @@index([errorType])
  @@index([generator])
  @@index([recovered])
  @@index([createdAt])
}

model FailurePattern {
  id          String   @id @default(cuid())

  // Pattern details
  patternType String       // recurring error pattern
  description String       @db.Text
  frequency   Int          @default(1)

  // Error characteristics
  errorType   String       // nextjs, typescript, etc.
  keywords    String[]     // Common keywords in error messages

  // Solution
  solution    String       @db.Text
  preventionRule String?   @db.Text  // Rule to add to system prompt

  // Learning status
  addedToPrompt Boolean   @default(false)
  promptVersion String?

  // Timestamps
  firstSeen   DateTime     @default(now())
  lastSeen    DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([errorType])
  @@index([frequency])
  @@index([addedToPrompt])
}

// ============================================================================
// INTEGRATION SYSTEM - OAuth & API Credentials
// ============================================================================

model IntegrationCredential {
  id             String   @id @default(cuid())
  userId         String
  integrationId  String   // twitter, openai, stripe, etc.
  type           String   // 'oauth' | 'api-key'

  // OAuth tokens
  accessToken    String?  @db.Text
  refreshToken   String?  @db.Text
  expiresAt      DateTime?
  scopes         String[] // OAuth scopes granted

  // API keys
  apiKey         String?  @db.Text
  apiSecret      String?  @db.Text
  
  // Additional config
  accountInfo    Json?    // Store account details (username, email, etc.)
  metadata       Json?    // Integration-specific metadata

  // Status
  isActive       Boolean  @default(true)
  lastUsedAt     DateTime?
  
  // Timestamps
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, integrationId])
  @@index([userId])
  @@index([integrationId])
  @@index([isActive])
}

model IntegrationUsage {
  id             String   @id @default(cuid())
  userId         String
  integrationId  String
  
  // Usage tracking
  action         String   // API method called
  success        Boolean
  responseTime   Int?     // milliseconds
  errorMessage   String?  @db.Text
  
  // Demo mode tracking
  isDemoMode     Boolean  @default(false)
  
  // Metadata
  metadata       Json?    // Request/response details
  
  // Timestamps
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([integrationId])
  @@index([createdAt])
  @@index([isDemoMode])
}

// =============================================================================
// VIRAL SHARING SYSTEM
// =============================================================================

model ShareLink {
  id                String        @id @default(cuid())
  generationJobId   String        @unique

  // Short share ID for clean URLs (e.g., autoforge.ai/share/abc123)
  shareId           String        @unique @default(cuid())

  // Share settings
  isPublic          Boolean       @default(true)
  allowRemix        Boolean       @default(true)
  showCode          Boolean       @default(false)  // Whether to show source code

  // Creator info (for attribution)
  creatorId         String
  creatorName       String?

  // Analytics
  viewCount         Int           @default(0)
  remixCount        Int           @default(0)
  lastViewedAt      DateTime?

  // Social metadata
  title             String?       // Custom title for sharing
  description       String?       // Custom description
  thumbnailUrl      String?       // Screenshot/preview image

  // Timestamps
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  expiresAt         DateTime?     // Optional expiration

  // Relations
  generationJob     GenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Cascade)
  views             ShareView[]
  remixes           ShareRemix[]

  @@index([shareId])
  @@index([creatorId])
  @@index([viewCount])
  @@index([createdAt])
  @@index([isPublic])
}

model ShareView {
  id            String    @id @default(cuid())
  shareLinkId   String

  // Visitor info (anonymous tracking)
  ipAddress     String?
  userAgent     String?
  referrer      String?   // Where they came from (Twitter, LinkedIn, etc.)
  country       String?

  // Session tracking
  sessionId     String?   // Track unique visitors

  // Timestamps
  viewedAt      DateTime  @default(now())

  // Relations
  shareLink     ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)

  @@index([shareLinkId])
  @@index([viewedAt])
  @@index([sessionId])
  @@index([referrer])
}

model ShareRemix {
  id                  String        @id @default(cuid())
  originalShareId     String

  // New generation created from remix
  newGenerationJobId  String        @unique

  // Remix creator
  remixedByUserId     String?       // Null if anonymous

  // Remix details
  modifiedPrompt      String?       // If they changed the prompt

  // Timestamps
  createdAt           DateTime      @default(now())

  // Relations
  originalShare       ShareLink     @relation(fields: [originalShareId], references: [id], onDelete: Cascade)
  newGenerationJob    GenerationJob @relation(fields: [newGenerationJobId], references: [id], onDelete: Cascade)

  @@index([originalShareId])
  @@index([remixedByUserId])
  @@index([createdAt])
}
