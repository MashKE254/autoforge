generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String?         @unique
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  accounts       Account[]
  generationJobs GenerationJob[]
  sessions       Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Module {
  id           String                @id @default(cuid())
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  name         String                @unique
  description  String
  code         String
  category     ModuleCategory
  framework    String                @default("nextjs")
  language     String                @default("typescript")
  testCoverage Float                 @default(0)
  successRate  Float                 @default(1.0)
  usageCount   Int                   @default(0)
  tags         String[]              @default([])
  generations  GenerationModule[]
  telemetry    GenerationTelemetry[]
  dependents   ModuleDependency[]    @relation("ModuleUsedBy")
  dependencies ModuleDependency[]    @relation("ModuleDepends")

  @@index([category])
  @@index([successRate])
  @@index([usageCount])
}

model ModuleDependency {
  id          String @id @default(cuid())
  moduleId    String
  dependsOnId String
  dependsOn   Module @relation("ModuleUsedBy", fields: [dependsOnId], references: [id], onDelete: Cascade)
  module      Module @relation("ModuleDepends", fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, dependsOnId])
  @@index([moduleId])
  @@index([dependsOnId])
}

model GenerationJob {
  id                    String                @id @default(cuid())
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  status                JobStatus             @default(PENDING)
  prompt                String
  planJson              String?
  result                String?
  userId                String
  blueprint             String?
  blueprintApprovedAt   DateTime?
  blueprintGeneratedAt  DateTime?
  completedModules      Int                   @default(0)
  errorLog              String?
  failedModules         Int                   @default(0)
  generationCompletedAt DateTime?
  generationStartedAt   DateTime?
  totalModules          Int                   @default(0)
  files                 GeneratedFile[]
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  modules               GenerationModule[]
  telemetry             GenerationTelemetry[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model GenerationModule {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now())
  generationJobId String
  moduleId        String
  status          String        @default("pending")
  generatedCode   String?
  error           String?
  generationJob   GenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Cascade)
  module          Module        @relation(fields: [moduleId], references: [id])

  @@unique([generationJobId, moduleId])
  @@index([generationJobId])
  @@index([status])
}

model GeneratedFile {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now())
  generationJobId String
  path            String
  content         String
  language        String
  size            Int           @default(0)
  generationJob   GenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Cascade)

  @@unique([generationJobId, path])
  @@index([generationJobId])
}

model GenerationTelemetry {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now())
  generationJobId String
  moduleId        String?
  eventType       String
  errorMessage    String?
  stackTrace      String?
  metadata        Json?
  generationJob   GenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Cascade)
  module          Module?       @relation(fields: [moduleId], references: [id])

  @@index([generationJobId])
  @@index([moduleId])
  @@index([eventType])
  @@index([createdAt])
}

model ModuleImprovement {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  moduleId        String
  oldVersion      String
  newVersion      String
  improvementType String
  description     String
  oldSuccessRate  Float
  newSuccessRate  Float

  @@index([moduleId])
  @@index([createdAt])
}

enum ModuleCategory {
  AUTH
  PAYMENT
  DATABASE
  UI
  API
  WORKFLOW
  AGENT
  INFRASTRUCTURE
  UTILITY
  TESTING
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  BLUEPRINT_GENERATED
  BLUEPRINT_APPROVED
  COMPOSING
  TESTING
  DEPLOYING
  CANCELLED
}
