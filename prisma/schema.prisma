// =============================================================================
// AUTOFORGE PRISMA SCHEMA - VERSION 2.0
// =============================================================================
// 
// File: prisma/schema.prisma
// 
// Complete schema including:
// - Authentication (NextAuth for platform)
// - Generation tracking
// - Monetization (Stripe Connect, subscriptions, payouts)
// - NEW: Managed Infrastructure (Supabase, Clerk, Vercel auto-provisioning)
//
// To apply: npx prisma migrate dev --name add_managed_infrastructure
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

// =============================================================================
// AUTHENTICATION MODELS (NextAuth - for AutoForge platform itself)
// =============================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =============================================================================
// USER MODEL
// =============================================================================

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  emailVerified    DateTime?
  image            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  
  // Stripe Customer ID (for platform subscription)
  stripeCustomerId String?   @unique
  
  // Relations
  accounts         Account[]
  sessions         Session[]
  generationJobs   GenerationJob[]
  
  // Monetization relations
  subscription     CreatorSubscription?
  connectedAccount StripeConnectedAccount?
  publishedApps    PublishedApp[]
  payouts          Payout[]
  
  // NEW: Managed Infrastructure
  managedProjects  ManagedProject[]

  @@index([email])
  @@index([stripeCustomerId])
}

// =============================================================================
// CREATOR SUBSCRIPTION (Platform billing - $49/$99/$249 per month)
// =============================================================================

model CreatorSubscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  
  // Stripe subscription details
  stripeSubscriptionId   String             @unique
  stripePriceId          String
  stripeCurrentPeriodEnd DateTime
  
  // Subscription status
  status                 SubscriptionStatus @default(ACTIVE)
  plan                   PlanTier           @default(STARTER)
  
  // Trial information
  trialEndsAt            DateTime?
  
  // Cancellation
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  
  // Timestamps
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  
  // Relations
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([stripeSubscriptionId])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  UNPAID
  PAUSED
}

enum PlanTier {
  FREE       // Limited features, 1 app, 14-day preview expiration
  STARTER    // $49/mo - 5 published apps, 8% fee
  PRO        // $99/mo - 20 published apps, 6% fee
  BUSINESS   // $249/mo - Unlimited apps, 4% fee
  ENTERPRISE // Custom pricing
}

// =============================================================================
// STRIPE CONNECTED ACCOUNT (For creator payouts)
// =============================================================================

model StripeConnectedAccount {
  id                    String   @id @default(cuid())
  userId                String   @unique
  
  // Stripe Connect account details
  stripeAccountId       String   @unique
  
  // Onboarding status
  onboardingComplete    Boolean  @default(false)
  chargesEnabled        Boolean  @default(false)
  payoutsEnabled        Boolean  @default(false)
  detailsSubmitted      Boolean  @default(false)
  
  // Account type
  accountType           String   @default("express") // express, standard, custom
  
  // Business information (from Stripe)
  businessName          String?
  businessUrl           String?
  country               String   @default("US")
  defaultCurrency       String   @default("usd")
  
  // Timestamps
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // Relations
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeAccountId])
  @@index([onboardingComplete])
}

// =============================================================================
// PUBLISHED APP (Monetized applications)
// =============================================================================

model PublishedApp {
  id                String       @id @default(cuid())
  
  // Owner
  userId            String
  generationJobId   String
  
  // App details
  name              String
  slug              String       @unique  // For subdomain: {slug}.autoforge.app
  description       String?
  logoUrl           String?
  
  // Custom domain (optional)
  customDomain      String?      @unique
  domainVerified    Boolean      @default(false)
  
  // Deployment
  deploymentUrl     String?
  vercelProjectId   String?
  
  // Pricing configuration
  pricingModel      PricingModel @default(SUBSCRIPTION)
  
  // Subscription pricing (in cents)
  monthlyPrice      Int?         // e.g., 900 = $9.00
  yearlyPrice       Int?
  
  // One-time pricing (in cents)
  oneTimePrice      Int?
  
  // Free trial
  trialDays         Int          @default(0)
  
  // Stripe product/price IDs
  stripeProductId    String?
  stripePriceMonthly String?
  stripePriceYearly  String?
  stripePriceOneTime String?
  
  // App status
  status            AppStatus    @default(DRAFT)
  publishedAt       DateTime?
  
  // Analytics
  totalRevenue      Int          @default(0) // In cents
  totalCustomers    Int          @default(0)
  monthlyRecurring  Int          @default(0) // MRR in cents
  
  // Timestamps
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  
  // Relations
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationJob     GenerationJob  @relation(fields: [generationJobId], references: [id], onDelete: Cascade)
  customers         AppCustomer[]
  transactions      Transaction[]

  @@index([userId])
  @@index([slug])
  @@index([status])
  @@index([customDomain])
}

enum PricingModel {
  FREE
  SUBSCRIPTION
  ONE_TIME
  FREEMIUM  // Free tier + paid features
}

enum AppStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  SUSPENDED
  ARCHIVED
}

// =============================================================================
// APP CUSTOMER (End-users who pay for published apps)
// =============================================================================

model AppCustomer {
  id                     String       @id @default(cuid())
  
  // Which app
  publishedAppId         String
  
  // Customer details
  email                  String
  name                   String?
  
  // Stripe customer (on the connected account)
  stripeCustomerId       String
  
  // Subscription details (if subscription model)
  stripeSubscriptionId   String?
  subscriptionStatus     String?      // active, canceled, past_due, etc.
  currentPeriodEnd       DateTime?
  
  // One-time purchase (if one-time model)
  purchasedAt            DateTime?
  
  // Access control
  hasAccess              Boolean      @default(true)
  accessExpiresAt        DateTime?
  
  // Timestamps
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  
  // Relations
  publishedApp           PublishedApp @relation(fields: [publishedAppId], references: [id], onDelete: Cascade)

  @@unique([publishedAppId, email])
  @@index([publishedAppId])
  @@index([stripeCustomerId])
  @@index([email])
}

// =============================================================================
// TRANSACTION (Revenue events)
// =============================================================================

model Transaction {
  id                    String            @id @default(cuid())
  
  // Which app
  publishedAppId        String
  
  // Stripe payment details
  stripePaymentIntentId String?           @unique
  stripeChargeId        String?
  stripeInvoiceId       String?
  
  // Amounts (all in cents)
  grossAmount           Int               // Total charged to customer
  stripeFee             Int               // Stripe's processing fee
  platformFee           Int               // AutoForge's fee (4-8%)
  netAmount             Int               // Creator receives this
  
  // Fee percentage at time of transaction
  platformFeePercent    Float             @default(8.0)
  
  // Currency
  currency              String            @default("usd")
  
  // Transaction type
  type                  TransactionType
  
  // Status
  status                TransactionStatus @default(PENDING)
  
  // Customer info
  customerEmail         String?
  
  // Timestamps
  createdAt             DateTime          @default(now())
  paidOutAt             DateTime?
  
  // Relations
  publishedApp          PublishedApp      @relation(fields: [publishedAppId], references: [id], onDelete: Cascade)
  payout                Payout?           @relation(fields: [payoutId], references: [id])
  payoutId              String?

  @@index([publishedAppId])
  @@index([status])
  @@index([createdAt])
  @@index([payoutId])
}

enum TransactionType {
  SUBSCRIPTION_PAYMENT
  ONE_TIME_PAYMENT
  REFUND
  CHARGEBACK
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  DISPUTED
}

// =============================================================================
// PAYOUT (Weekly payouts to creators)
// =============================================================================

model Payout {
  id                  String       @id @default(cuid())
  
  // Creator
  userId              String
  
  // Stripe payout details
  stripePayoutId      String?      @unique
  stripeTransferId    String?
  
  // Amount
  amount              Int          // In cents
  currency            String       @default("usd")
  
  // Period this payout covers
  periodStart         DateTime
  periodEnd           DateTime
  
  // Status
  status              PayoutStatus @default(PENDING)
  
  // Failure info
  failureCode         String?
  failureMessage      String?
  
  // Timestamps
  createdAt           DateTime     @default(now())
  arrivedAt           DateTime?
  
  // Relations
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions        Transaction[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum PayoutStatus {
  PENDING
  IN_TRANSIT
  PAID
  FAILED
  CANCELED
}

// =============================================================================
// MANAGED INFRASTRUCTURE (NEW - AutoForge 2.0)
// =============================================================================
// These models support the "Go Live" feature that auto-provisions:
// - Supabase (PostgreSQL database)
// - Clerk (Authentication)
// - Stripe (Payments in test mode)
// - Vercel (Hosting)
// =============================================================================

model ManagedProject {
  id                    String               @id @default(cuid())
  userId                String
  generationJobId       String               @unique
  
  // Supabase
  supabaseProjectId     String?
  supabaseUrl           String?
  supabaseAnonKey       String?
  supabaseServiceKey    String?              // Encrypted
  supabaseDbPassword    String?              // Encrypted
  
  // Clerk (if using per-project instances)
  clerkInstanceId       String?
  clerkPublishableKey   String?
  clerkSecretKey        String?              // Encrypted
  
  // Vercel
  vercelProjectId       String?
  vercelDeploymentId    String?
  vercelUrl             String?
  vercelTeamId          String?
  
  // Stripe (Test Mode for Preview)
  stripeTestPublishable String?
  stripeTestSecret      String?              // Encrypted
  stripeTestWebhookId   String?
  stripeTestWebhookSecret String?            // Encrypted
  
  // Production Stripe (after Go Live)
  stripeLivePublishable String?
  stripeLiveSecret      String?              // Encrypted
  stripeLiveWebhookId   String?
  stripeLiveWebhookSecret String?            // Encrypted
  
  // Environment Variables (JSON blob of all env vars)
  environmentVariables  Json?
  
  // Status
  status                ManagedProjectStatus @default(PROVISIONING)
  provisioningStep      String?              // Current step being executed
  errorMessage          String?
  
  // Lifecycle
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  expiresAt             DateTime?            // For free tier cleanup (7 days)
  
  // Whether this is a paid/permanent project
  isPermanent           Boolean              @default(false)
  
  // Relations
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationJob         GenerationJob        @relation(fields: [generationJobId], references: [id], onDelete: Cascade)
  provisioningLogs      ProvisioningLog[]

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([vercelUrl])
}

enum ManagedProjectStatus {
  PROVISIONING       // Initial state - setting up infrastructure
  DATABASE_READY     // Supabase provisioned
  AUTH_READY         // Clerk configured
  PAYMENTS_READY     // Stripe test mode configured
  PREVIEW_READY      // Deployed to Vercel, ready to use
  DEPLOYED           // Production deployment complete
  UPGRADING          // Being upgraded (e.g., adding production Stripe)
  ERROR              // Something went wrong
  EXPIRED            // Free tier expired and cleaned up
  DELETED            // Manually deleted by user
}

// Track each provisioning step for debugging and progress reporting
model ProvisioningLog {
  id                String         @id @default(cuid())
  managedProjectId  String
  
  // Step information
  step              String         // 'supabase_create', 'supabase_migrate', 'clerk_setup', etc.
  status            String         // 'started', 'completed', 'failed', 'skipped'
  
  // Timing
  startedAt         DateTime       @default(now())
  completedAt       DateTime?
  duration          Int?           // Duration in milliseconds
  
  // Error information
  errorMessage      String?
  errorStack        String?
  
  // Additional metadata
  metadata          Json?          // Any extra info about this step
  
  // Relations
  managedProject    ManagedProject @relation(fields: [managedProjectId], references: [id], onDelete: Cascade)

  @@index([managedProjectId])
  @@index([step])
  @@index([status])
  @@index([startedAt])
}

// =============================================================================
// GENERATION MODELS
// =============================================================================

model GenerationJob {
  id                    String                @id @default(cuid())
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  status                JobStatus             @default(PENDING)
  prompt                String
  enhancedPrompt        String?
  enhancementUsed       Boolean               @default(false)
  planJson              String?
  result                String?
  filesJson             String?
  userId                String
  blueprint             String?
  blueprintApprovedAt   DateTime?
  blueprintGeneratedAt  DateTime?
  completedModules      Int                   @default(0)
  errorLog              String?
  failedModules         Int                   @default(0)
  generationCompletedAt DateTime?
  generationStartedAt   DateTime?
  totalModules          Int                   @default(0)

  // NEW: Generation mode (Personal Tool vs SaaS)
  generationMode        GenerationMode        @default(PERSONAL)
  parentJobId           String?               // For SaaS upgrades, points to original personal tool

  // Relations
  files                 GeneratedFile[]
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  modules               GenerationModule[]
  telemetry             GenerationTelemetry[]
  previewSessions       PreviewSession[]
  deployments           Deployment[]

  // Monetization relation
  publishedApps         PublishedApp[]

  // NEW: Managed Infrastructure relation
  managedProject        ManagedProject?

  // NEW: SaaS upgrade tracking
  parentJob             GenerationJob?        @relation("SaaSUpgrade", fields: [parentJobId], references: [id])
  upgradedJobs          GenerationJob[]       @relation("SaaSUpgrade")

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([generationMode])
  @@index([parentJobId])
}

model GeneratedFile {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now())
  generationJobId String
  path            String
  content         String
  language        String
  size            Int           @default(0)
  generationJob   GenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Cascade)

  @@unique([generationJobId, path])
  @@index([generationJobId])
}

model GenerationModule {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now())
  generationJobId String
  moduleId        String
  status          String        @default("pending")
  generatedCode   String?
  error           String?
  generationJob   GenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Cascade)
  module          Module        @relation(fields: [moduleId], references: [id])

  @@unique([generationJobId, moduleId])
  @@index([generationJobId])
  @@index([status])
}

model GenerationTelemetry {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now())
  generationJobId String
  moduleId        String?
  eventType       String
  errorMessage    String?
  stackTrace      String?
  metadata        Json?
  generationJob   GenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Cascade)
  module          Module?       @relation(fields: [moduleId], references: [id])

  @@index([generationJobId])
  @@index([moduleId])
  @@index([eventType])
  @@index([createdAt])
}

// =============================================================================
// MODULE SYSTEM
// =============================================================================

model Module {
  id           String                @id @default(cuid())
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  name         String                @unique
  description  String
  code         String
  category     ModuleCategory
  framework    String                @default("nextjs")
  language     String                @default("typescript")
  testCoverage Float                 @default(0)
  successRate  Float                 @default(1.0)
  usageCount   Int                   @default(0)
  tags         String[]              @default([])
  generations  GenerationModule[]
  telemetry    GenerationTelemetry[]
  dependents   ModuleDependency[]    @relation("ModuleUsedBy")
  dependencies ModuleDependency[]    @relation("ModuleDepends")

  @@index([category])
  @@index([successRate])
  @@index([usageCount])
}

model ModuleDependency {
  id          String @id @default(cuid())
  moduleId    String
  dependsOnId String
  dependsOn   Module @relation("ModuleUsedBy", fields: [dependsOnId], references: [id], onDelete: Cascade)
  module      Module @relation("ModuleDepends", fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, dependsOnId])
  @@index([moduleId])
  @@index([dependsOnId])
}

model ModuleImprovement {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  moduleId        String
  oldVersion      String
  newVersion      String
  improvementType String
  description     String
  oldSuccessRate  Float
  newSuccessRate  Float

  @@index([moduleId])
  @@index([createdAt])
}

enum ModuleCategory {
  AUTH
  PAYMENT
  DATABASE
  UI
  API
  WORKFLOW
  AGENT
  INFRASTRUCTURE
  UTILITY
  TESTING
  GITHUB          // GitHub integration (OAuth, webhooks, PR automation)
  STORAGE         // File storage (S3, Supabase Storage, uploads)
  VECTOR_DB       // Vector databases (Pinecone, pgvector, Chroma)
  REALTIME        // Real-time/WebSocket (Socket.io, Supabase Realtime)
  PDF             // PDF generation (invoices, reports)
  PACKAGE_MANAGER // Package manager integration (npm, pip, composer)
  MARKETPLACE     // Marketplace & revenue split logic
  BOT             // Chat bots (Discord, Slack, Telegram, WhatsApp, Twitter)
  SCRAPING        // Web scraping & browser automation (Puppeteer, Playwright)
  ECOMMERCE       // E-commerce (cart, checkout, inventory, shipping, tax)
  MESSAGING       // Messaging (SMS, push notifications, email templates)
  CMS             // Content management (rich text, media, versioning, SEO)
}

// =============================================================================
// PREVIEW AND DEPLOYMENT
// =============================================================================

model PreviewSession {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now())
  expiresAt       DateTime
  generationJobId String
  files           Json
  accessCount     Int           @default(0)
  lastAccessedAt  DateTime?
  generationJob   GenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Cascade)

  @@index([generationJobId])
  @@index([expiresAt])
}

model Deployment {
  id                 String           @id @default(cuid())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  generationJobId    String
  vercelDeploymentId String?          @unique
  vercelProjectId    String?
  deploymentUrl      String?
  status             DeploymentStatus @default(PENDING)
  errorMessage       String?
  buildLogs          String?
  generationJob      GenerationJob    @relation(fields: [generationJobId], references: [id], onDelete: Cascade)

  @@index([generationJobId])
  @@index([status])
  @@index([createdAt])
}

enum DeploymentStatus {
  PENDING
  BUILDING
  READY
  ERROR
  CANCELLED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  BLUEPRINT_GENERATED
  BLUEPRINT_APPROVED
  COMPOSING
  TESTING
  DEPLOYING
  CANCELLED
}

enum GenerationMode {
  PERSONAL      // Simple, single-user tool (localStorage, no auth)
  SAAS          // Full SaaS with auth, payments, multi-tenant DB
  SAAS_UPGRADE  // Personal tool upgraded to SaaS
}

// =============================================================================
// INFRASTRUCTURE CLEANUP TRACKING
// =============================================================================
// Track when free tier projects should be cleaned up

model CleanupTask {
  id                String        @id @default(cuid())
  managedProjectId  String
  
  // What to clean up
  cleanupType       CleanupType
  resourceId        String        // Supabase project ID, Vercel project ID, etc.
  
  // Scheduling
  scheduledFor      DateTime
  
  // Status
  status            CleanupStatus @default(PENDING)
  
  // Execution
  executedAt        DateTime?
  errorMessage      String?
  retryCount        Int           @default(0)
  
  // Timestamps
  createdAt         DateTime      @default(now())

  @@index([scheduledFor])
  @@index([status])
  @@index([managedProjectId])
}

enum CleanupType {
  SUPABASE_PROJECT
  CLERK_INSTANCE
  VERCEL_PROJECT
  STRIPE_WEBHOOK
  FULL_PROJECT      // Clean up everything
}

enum CleanupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

// =============================================================================
// USAGE TRACKING (For billing and limits)
// =============================================================================

model UsageRecord {
  id          String      @id @default(cuid())
  userId      String
  
  // What was used
  usageType   UsageType
  quantity    Int         @default(1)
  
  // Context
  resourceId  String?     // generationJobId, managedProjectId, etc.
  
  // Billing period
  periodStart DateTime
  periodEnd   DateTime
  
  // Timestamps
  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([usageType])
  @@index([periodStart, periodEnd])
  @@index([createdAt])
}

enum UsageType {
  GENERATION          // App generation
  MANAGED_PROJECT     // Provisioned infrastructure
  DEPLOYMENT          // Vercel deployment
  AI_TOKENS           // Claude API tokens used
  BANDWIDTH           // Data transfer
}
