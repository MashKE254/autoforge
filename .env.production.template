# ===================================================================
# PRODUCTION ENVIRONMENT - AutoForge
# ===================================================================
# Copy this file to .env.local and fill in all required values
# All simulation code has been removed - real API keys are required
# ===================================================================

# ============================================================================
# DATABASE (REQUIRED) - Already Configured
# ============================================================================
DATABASE_URL="your_postgresql_database_url"
DIRECT_URL="your_postgresql_database_url"  # For migrations

# ============================================================================
# AUTHENTICATION (REQUIRED) - Already Configured
# ============================================================================
NEXTAUTH_URL="http://localhost:3000"  # or https://yourdomain.com in production
NEXTAUTH_SECRET="your_nextauth_secret_key"  # Generate with: openssl rand -base64 32

# OAuth Providers (Google, GitHub, etc.)
GOOGLE_CLIENT_ID="your_google_oauth_client_id"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"
GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"

# ============================================================================
# AI CODE GENERATION (REQUIRED) ✅ CRITICAL
# ============================================================================
# Get your API key from: https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-api03-..."

# ============================================================================
# DEPLOYMENT PLATFORM (REQUIRED) ✅ CRITICAL
# ============================================================================
# Get your Vercel token from: https://vercel.com/account/tokens
# Get your team ID from: https://vercel.com/teams/[your-team]/settings
VERCEL_TOKEN="your_vercel_api_token"
VERCEL_TEAM_ID="team_xxxxxxxxxxxx"

# ============================================================================
# PAYMENT PROCESSING (REQUIRED) - For AutoForge Subscriptions
# ============================================================================
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_..." # or sk_test_... for testing
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..." # or pk_test_... for testing

# ============================================================================
# ENCRYPTION (REQUIRED)
# ============================================================================
# Generate a secure random key: openssl rand -hex 32
ENCRYPTION_KEY="your_64_character_hex_encryption_key"

# ============================================================================
# INFRASTRUCTURE PROVISIONING (OPTIONAL)
# ============================================================================
# Only required if you want users to deploy with auto-provisioned infrastructure
# via the "Go Live" feature. Otherwise, users will get deployed apps without
# auto-provisioned databases/auth/payments.

# Supabase - For provisioning PostgreSQL databases
# Get token from: https://app.supabase.com/account/tokens
# Get org ID from: https://app.supabase.com/org/[your-org]/general
SUPABASE_ACCESS_TOKEN="sbp_..."
SUPABASE_ORG_ID="your_supabase_organization_id"

# Clerk - For provisioning authentication
# Get key from: https://dashboard.clerk.com
CLERK_PLATFORM_SECRET_KEY="sk_..."

# Stripe Test Mode - For provisioning payment processing in generated apps
# Get keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_TEST_SECRET_KEY="sk_test_..."
STRIPE_TEST_PUBLISHABLE_KEY="pk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"  # or https://yourdomain.com
NODE_ENV="production"  # or "development"

# ============================================================================
# OPTIONAL - Email Notifications
# ============================================================================
# Configure if you want to send email notifications
RESEND_API_KEY="re_..."
EMAIL_FROM="notifications@yourdomain.com"

# ============================================================================
# OPTIONAL - Analytics
# ============================================================================
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ===================================================================
# SETUP CHECKLIST
# ===================================================================
#
# REQUIRED FOR BASIC OPERATION:
# ✅ DATABASE_URL - Your PostgreSQL database
# ✅ NEXTAUTH_URL & NEXTAUTH_SECRET - Authentication
# ✅ ANTHROPIC_API_KEY - AI code generation
# ✅ VERCEL_TOKEN & VERCEL_TEAM_ID - Deployments
# ✅ STRIPE_SECRET_KEY - Payment processing
# ✅ ENCRYPTION_KEY - Secure credential storage
#
# OPTIONAL FOR "GO LIVE" FEATURE:
# □ SUPABASE_ACCESS_TOKEN & SUPABASE_ORG_ID - Database provisioning
# □ CLERK_PLATFORM_SECRET_KEY - Auth provisioning
# □ STRIPE_TEST_SECRET_KEY - Payment provisioning
#
# COST ESTIMATES:
# - Anthropic API: ~$3-5 per complex app generation (pay-as-you-go)
# - Vercel: $0-$20/month (Hobby/Pro plan)
# - Supabase: $25/month per provisioned database
# - Clerk: Free up to 5k users, then $25/month
# - Stripe: Standard payment processing fees
#
# MINIMUM MONTHLY COST: $0-$20 + pay-as-you-go API costs
# ===================================================================
